{
  "ConnectionStrings": {
    "ExpenseHub": "Data Source=expensehub.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "QueueName": "expensehub.reports",
    "UseTls": false,
    "TimeoutSeconds": 10
  }
}
