@ExpenseHub_Api_HostAddress = http://localhost:5245

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

###

# Public registration. The extra role property is intentionally ignored.
@newUserPassword = REPLACE_WITH_VALID_PASSWORD

POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
	"email": "employee@example.com",
	"password": "{{newUserPassword}}",
	"role": "Admin"
}

###

# Login as the registered user or the locally configured SeedAdmin.
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
	"email": "employee@example.com",
	"password": "{{newUserPassword}}"
}

###

# Set @adminAccessToken to a valid Admin bearer token before running Admin requests.
@adminAccessToken = REPLACE_WITH_ADMIN_ACCESS_TOKEN
@userAccessToken = REPLACE_WITH_STANDARD_USER_ACCESS_TOKEN

GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

###

# A standard user's token should receive 403 here.
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{userAccessToken}}
Accept: application/json

###

# Roles is the complete desired role set for this user.
# After changing roles, the affected user must log in again to get updated token claims.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["Employee"]
}

###

# Send an empty set to remove Employee from this user.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": []
}

###

# A role outside the allowlist is rejected with 400.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["UnknownRole"]
}

###

# A valid role set for a missing user should return 404.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/DOES_NOT_EXIST/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["Employee"]
}

###

# Removing Admin from the current Admin should return 409.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_ADMIN_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": []
}

###

# I04 — Set @employeeAccessToken to a token of a user with the Employee role.
@employeeAccessToken = REPLACE_WITH_EMPLOYEE_ACCESS_TOKEN
@otherEmployeeAccessToken = REPLACE_WITH_OTHER_EMPLOYEE_ACCESS_TOKEN
@expenseId = REPLACE_WITH_EXPENSE_ID

# Create a draft. Owner, status and id are always set by the server.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "Almoço com cliente",
	"amount": 150.75,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}

###

# Extra fields such as ownerId and status are ignored.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"ownerId": "someone-else",
	"status": "Paid",
	"description": "Tentativa de mass assignment",
	"amount": 10,
	"expenseDate": "2026-09-30",
	"categoryId": 2
}

###

# Invalid description, amount and future date should return 400.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "curta",
	"amount": 0,
	"expenseDate": "2999-01-01",
	"categoryId": 1
}

###

# The owner edits their own draft.
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "Jantar com cliente",
	"amount": 200.00,
	"expenseDate": "2026-09-30",
	"categoryId": 2
}

###

# Another Employee cannot see or edit the draft: 404.
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{otherEmployeeAccessToken}}
Content-Type: application/json

{
	"description": "Edição indevida de outro usuário",
	"amount": 1,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}
