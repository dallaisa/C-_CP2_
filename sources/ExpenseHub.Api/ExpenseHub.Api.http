@ExpenseHub_Api_HostAddress = http://localhost:5245

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

###

# Public registration. The extra role property is intentionally ignored.
@newUserPassword = REPLACE_WITH_VALID_PASSWORD

POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
	"email": "employee@example.com",
	"password": "{{newUserPassword}}",
	"role": "Admin"
}

###

# Login as the registered user or the locally configured SeedAdmin.
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
	"email": "employee@example.com",
	"password": "{{newUserPassword}}"
}

###

# Set @adminAccessToken to a valid Admin bearer token before running Admin requests.
@adminAccessToken = REPLACE_WITH_ADMIN_ACCESS_TOKEN
@userAccessToken = REPLACE_WITH_STANDARD_USER_ACCESS_TOKEN

GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

###

# A standard user's token should receive 403 here.
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{userAccessToken}}
Accept: application/json

###

# Roles is the complete desired role set for this user.
# After changing roles, the affected user must log in again to get updated token claims.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["Employee"]
}

###

# Send an empty set to remove Employee from this user.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": []
}

###

# A role outside the allowlist is rejected with 400.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["UnknownRole"]
}

###

# A valid role set for a missing user should return 404.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/DOES_NOT_EXIST/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": ["Employee"]
}

###

# Removing Admin from the current Admin should return 409.
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/REPLACE_WITH_ADMIN_USER_ID/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"roles": []
}

###

# I04 — Set @employeeAccessToken to a token of a user with the Employee role.
@employeeAccessToken = REPLACE_WITH_EMPLOYEE_ACCESS_TOKEN
@otherEmployeeAccessToken = REPLACE_WITH_OTHER_EMPLOYEE_ACCESS_TOKEN
@expenseId = REPLACE_WITH_EXPENSE_ID

# Create a draft. Owner, status and id are always set by the server.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "Almoço com cliente",
	"amount": 150.75,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}

###

# Extra fields such as ownerId and status are ignored.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"ownerId": "someone-else",
	"status": "Paid",
	"description": "Tentativa de mass assignment",
	"amount": 10,
	"expenseDate": "2026-09-30",
	"categoryId": 2
}

###

# Invalid description, amount and future date should return 400.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "curta",
	"amount": 0,
	"expenseDate": "2999-01-01",
	"categoryId": 1
}

###

# The owner edits their own draft.
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeAccessToken}}
Content-Type: application/json

{
	"description": "Jantar com cliente",
	"amount": 200.00,
	"expenseDate": "2026-09-30",
	"categoryId": 2
}

###

# Another Employee cannot see or edit the draft: 404.
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{otherEmployeeAccessToken}}
Content-Type: application/json

{
	"description": "Edição indevida de outro usuário",
	"amount": 1,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}

###

# I05 — Tokens for each profile. Log in again after an Admin changes roles.
@approverAccessToken = REPLACE_WITH_APPROVER_ACCESS_TOKEN
@financeAccessToken = REPLACE_WITH_FINANCE_ACCESS_TOKEN
@auditorAccessToken = REPLACE_WITH_AUDITOR_ACCESS_TOKEN

# The owner submits a draft: 200 and status Submitted. There is no request body.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeAccessToken}}

###

# Submitting again returns 409 and records no new history entry.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{employeeAccessToken}}

###

# Another Employee cannot submit it: 404.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{otherEmployeeAccessToken}}

###

# An Approver or Auditor cannot submit: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}/submit
Authorization: Bearer {{auditorAccessToken}}

###

# Employee: only their own expenses.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{employeeAccessToken}}

###

# Approver: only Submitted expenses.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{approverAccessToken}}

###

# Finance: only Approved and Paid expenses.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{financeAccessToken}}

###

# Auditor: all expenses.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{auditorAccessToken}}

###

# Admin without a functional role: 403.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminAccessToken}}

###

# Anonymous request: 401.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses

###

# Detail visible to the viewer: 200.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{employeeAccessToken}}

###

# Detail outside the viewer's scope (another Employee, or Finance on a Submitted expense): 404.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{otherEmployeeAccessToken}}

###

# I06 — Access matrix negative cases.
@noRoleAccessToken = REPLACE_WITH_NO_ROLE_ACCESS_TOKEN

# Invalid token: 401.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer invalid-token

###

# Authenticated user without roles: 403.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{noRoleAccessToken}}

###

# Admin has no functional access to expenses: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
	"description": "Admin tentando criar reembolso",
	"amount": 10,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}

###

# Auditor reads everything but cannot write: 403.
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{auditorAccessToken}}
Content-Type: application/json

{
	"description": "Auditor tentando editar",
	"amount": 10,
	"expenseDate": "2026-09-30",
	"categoryId": 1
}

###

# Changing the id in the URL does not expose another Employee's expense: 404.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{otherEmployeeAccessToken}}

###

# Finance cannot read a Submitted expense: 404.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{expenseId}}
Authorization: Bearer {{financeAccessToken}}

###

# I07 — Set @submittedExpenseId to a Submitted expense owned by another user.
@submittedExpenseId = REPLACE_WITH_SUBMITTED_EXPENSE_ID
@ownSubmittedExpenseId = REPLACE_WITH_APPROVER_OWN_SUBMITTED_EXPENSE_ID

# An Approver approves another user's Submitted expense: 200. There is no request body.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{submittedExpenseId}}/approve
Authorization: Bearer {{approverAccessToken}}

###

# Approving again returns 409 and records no new history entry.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{submittedExpenseId}}/approve
Authorization: Bearer {{approverAccessToken}}

###

# An Approver rejects a Submitted expense with a justification: 200.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{submittedExpenseId}}/reject
Authorization: Bearer {{approverAccessToken}}
Content-Type: application/json

{
	"reason": "Comprovante ilegível, reenviar"
}

###

# A justification shorter than 10 characters returns 400.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{submittedExpenseId}}/reject
Authorization: Bearer {{approverAccessToken}}
Content-Type: application/json

{
	"reason": "curta"
}

###

# The owner cannot decide on their own expense, even with Employee and Approver roles: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{ownSubmittedExpenseId}}/approve
Authorization: Bearer {{approverAccessToken}}

###

# Users without the Approver role cannot decide: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{submittedExpenseId}}/approve
Authorization: Bearer {{employeeAccessToken}}

###

# I08 — Set @approvedExpenseId to an Approved expense owned by another user.
@approvedExpenseId = REPLACE_WITH_APPROVED_EXPENSE_ID
@ownApprovedExpenseId = REPLACE_WITH_FINANCE_OWN_APPROVED_EXPENSE_ID

# Finance pays another user's Approved expense: 200, status Paid and a payment record. There is no request body.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/pay
Authorization: Bearer {{financeAccessToken}}

###

# Paying again returns 409 and creates no new payment record or history entry.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/pay
Authorization: Bearer {{financeAccessToken}}

###

# The owner cannot pay their own expense, even with Employee and Finance roles: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{ownApprovedExpenseId}}/pay
Authorization: Bearer {{financeAccessToken}}

###

# Users without the Finance role cannot pay: 403.
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/pay
Authorization: Bearer {{auditorAccessToken}}

###

# The owner reads the full history of their expense: 200.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/history
Authorization: Bearer {{employeeAccessToken}}

###

# The Auditor reads any history: 200.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/history
Authorization: Bearer {{auditorAccessToken}}

###

# Another Employee cannot read the history: 404.
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{approvedExpenseId}}/history
Authorization: Bearer {{otherEmployeeAccessToken}}
