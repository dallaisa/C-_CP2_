{
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "QueueName": "expensehub.reports",
    "UseTls": false,
    "TimeoutSeconds": 10
  },
  "Worker": {
    "MaxAttempts": 5,
    "RetryDelaySeconds": 5,
    "PollIntervalMilliseconds": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
