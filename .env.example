# Copie para .env (ignorado pelo Git) e preencha. Nao versione valores reais.
# Formato do Compose: sem aspas e sem interpolacao.

# Commit completo (40 caracteres) das imagens publicadas que serao executadas.
# Nao use "latest": a versao entregue e identificada pelo commit.
IMAGE_TAG=

# Prefixo do registry/owner das imagens. Padrao: ghcr.io/dallaisa
# IMAGE_REGISTRY=ghcr.io/dallaisa

# Usuario e senha do RabbitMQ (usados pelo broker, pela web e pelo worker).
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Conta Admin criada na primeira inicializacao.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
